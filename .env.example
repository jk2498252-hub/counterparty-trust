# PostgreSQL connection string
DATABASE_URL=postgres://kct:kct@localhost:5432/kct
# Docker Compose requires a unique password (use a URL-safe value).
POSTGRES_PASSWORD=

# Random secret for signing login sessions (at least 32 characters).
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# 32-byte key (base64) used to encrypt bank account numbers at rest.
# Generate one with:  openssl rand -base64 32
# Keep it safe: losing it makes stored account numbers unreadable.
DATA_ENCRYPTION_KEY=

# Where uploaded documents are stored (outside the web root)
UPLOAD_DIR=./storage/uploads

# Require two-factor login (authenticator app) for every user. Keep "true" in production.
REQUIRE_MFA=true

# Public production setup is disabled by default. Provision the first admin via
# npm run user:create, or temporarily set a random 32+ character SETUP_TOKEN.
# Enter that token in the setup form; remove it after provisioning.
SETUP_TOKEN=

# Pilot economics used on the dashboard (KES)
HOURLY_COST_KES=1500
PRICE_DIGITAL_KES=12000
PRICE_ENHANCED_KES=25000
PRICE_EXTENDED_KES=65000

# Number of distinct people who must approve a bank-detail change
PAYMENT_APPROVALS_REQUIRED=2
